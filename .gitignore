# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# OS cruft
.DS_Store

# local agent/tooling scratch state
.remember/
.claude/worktrees/

# Kubeconfig might contain secrets
*.kubeconfig

# graphify knowledge-graph build artifacts.
# The queryable graph, the audit report and the agent-crawlable wiki are
# committed so a fresh clone can answer questions without a rebuild (see the
# graphify section of CLAUDE.md). Everything else is local: the extraction
# cache, the dated pre-rebuild backups, and the HTML render, which is large
# and regenerates from graph.json with `graphify export html`.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/wiki/

# generated obsidian knowledge-graph vault (regenerate: graphify export obsidian --dir obsidian/graph)
obsidian/graph/
